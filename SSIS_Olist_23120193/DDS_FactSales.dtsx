                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT i.order_id, i.order_item_id, i.product_id, i.price, i.freight_value, o.customer_unique_id,
       CONVERT(INT, CONVERT(CHAR(8), o.order_purchase_timestamp, 112)) AS order_date_key
