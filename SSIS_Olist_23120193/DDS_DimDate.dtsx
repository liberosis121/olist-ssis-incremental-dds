              SQLTask:SqlStatementSource="DECLARE @exec UNIQUEIDENTIFIER = CONVERT(UNIQUEIDENTIFIER, ?), @pkg VARCHAR(100) = ?, @start DATETIME2(3) = CONVERT(DATETIME2(3), ?, 121),&#xA;        @lset DATETIME2(3) = TRY_CONVERT(DATETIME2(3), ?, 121), @cet DATETIME2(3) = TRY_CONVERT(DATETIME2(3), ?, 121),&#xA;        @err NVARCHAR(4000) = ?;&#xA;IF EXISTS (SELECT 1 FROM meta.etl_log WHERE execution_id = @exec AND package_name = @pkg)&#xA;    UPDATE meta.etl_log SET end_time = SYSDATETIME(), status = 'FAILED', error_message = LEFT(ISNULL(error_message + N' | ', N'') + @err, 4000)&#xA;    WHERE execution_id = @exec AND package_name = @pkg;&#xA;ELSE&#xA;    INSERT INTO meta.etl_log (execution_id, package_name, start_time, end_time, status, lset, cet, error_message)&#xA;    VALUES (@exec, @pkg, @start, SYSDATETIME(), 'FAILED', @lset, @cet, LEFT(@err, 4000));" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
