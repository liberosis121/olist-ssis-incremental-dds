        <DTS:Executable
          DTS:refId="Package.EventHandlers[OnError]\Log error"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Ghi lỗi vào meta.etl_log (status = FAILED). LSET không đổi nên lần chạy sau sẽ lấy lại đúng phần dữ liệu này."
          DTS:DTSID="{CD11C9DF-DF94-459F-9162-1EDC737A8FA2}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Log error"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{296B916C-9347-4F3C-A104-4CA556CEE445}"
              SQLTask:SqlStatementSource="DECLARE @exec UNIQUEIDENTIFIER = CONVERT(UNIQUEIDENTIFIER, ?), @pkg VARCHAR(100) = ?, @start DATETIME2(3) = CONVERT(DATETIME2(3), ?, 121),&#xA;        @lset DATETIME2(3) = TRY_CONVERT(DATETIME2(3), ?, 121), @cet DATETIME2(3) = TRY_CONVERT(DATETIME2(3), ?, 121),&#xA;        @err NVARCHAR(4000) = ?;&#xA;IF EXISTS (SELECT 1 FROM meta.etl_log WHERE execution_id = @exec AND package_name = @pkg)&#xA;    UPDATE meta.etl_log SET end_time = SYSDATETIME(), status = 'FAILED', error_message = LEFT(ISNULL(error_message + N' | ', N'') + @err, 4000)&#xA;    WHERE execution_id = @exec AND package_name = @pkg;&#xA;ELSE&#xA;    INSERT INTO meta.etl_log (execution_id, package_name, start_time, end_time, status, lset, cet, error_message)&#xA;    VALUES (@exec, @pkg, @start, SYSDATETIME(), 'FAILED', @lset, @cet, LEFT(@err, 4000));" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="System::ExecutionInstanceGUID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="130"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
