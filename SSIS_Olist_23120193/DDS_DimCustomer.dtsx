          SQLTask:SqlStatementSource="DECLARE @exec UNIQUEIDENTIFIER = CONVERT(UNIQUEIDENTIFIER, ?), @pkg VARCHAR(100) = ?,&#xA;        @start DATETIME2(3) = CONVERT(DATETIME2(3), ?, 121),&#xA;        @lset DATETIME2(3) = CONVERT(DATETIME2(3), ?, 121), @cet DATETIME2(3) = CONVERT(DATETIME2(3), ?, 121),&#xA;        @ext INT = ?, @ins INT = ?, @upd INT = ?, @unch INT = ?;&#xA;INSERT INTO meta.etl_log (execution_id, package_name, start_time, end_time, status, lset, cet, rows_extracted, rows_inserted, rows_updated, rows_unchanged)&#xA;VALUES (@exec, @pkg, @start, SYSDATETIME(), 'SUCCESS', @lset, @cet, @ext, @ins, @upd, @unch);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
