          DTS:Description="Ghi lỗi vào meta.etl_log (status = FAILED). LSET không đổi nên lần chạy sau sẽ lấy lại đúng phần dữ liệu này."
          DTS:DTSID="{89F805B9-7BC7-4638-8B29-1B79DBE0289E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Log error"
